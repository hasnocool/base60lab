> """Frequency ratios, harmonics, and phase for exact rational arithmetic.
  
> This module provides exact rational representations for musical frequency ratios,
> harmonic series, and phase as fractions of a complete turn. All internal
> arithmetic uses Rational numbers — never floating-point.
> """
  
> from __future__ import annotations
  
> from dataclasses import dataclass
> from typing import Union
  
> from .core.rational import Rational
  
  
> def ratio_to_fraction(numerator: int, denominator: int = 1) -> Rational:
>     """Return the exact rational representation of a frequency ratio.
  
>     Args:
>         numerator: Frequency ratio numerator (must be positive).
>         denominator: Frequency ratio denominator (must be positive).
  
>     Returns:
>         Rational representing the exact ratio in lowest terms.
  
>     Raises:
>         ValueError: If numerator or denominator is not positive.
>         ZeroDivisionError: If denominator is zero.
  
>     Examples:
>         >>> ratio_to_fraction(2, 1)
>         Rational(2)
>         >>> ratio_to_fraction(3, 2)
>         Rational(3/2)
>         >>> ratio_to_fraction(5, 4)
>         Rational(5/4)
>     """
>     if numerator <= 0:
>         raise ValueError("numerator must be positive")
>     if denominator <= 0:
>         raise ValueError("denominator must be positive")
>     return Rational(numerator, denominator)
  
  
> @dataclass(frozen=True, order=True)
> class FrequencyRatio:
>     """An exact frequency ratio p/q in lowest terms.
  
>     Represents the ratio between two frequencies as an exact rational number.
>     All arithmetic operations preserve exactness using Rational internally.
>     """
  
>     _value: Rational
  
>     def __init__(
>         self,
>         numerator: int | Rational,
>         denominator: int = 1,
>     ) -> None:
>         if isinstance(numerator, Rational):
>             value = numerator
>         else:
>             if numerator <= 0:
>                 raise ValueError("numerator must be positive")
>             if denominator == 0:
>                 raise ZeroDivisionError("denominator cannot be zero")
>             if denominator < 0:
>                 raise ValueError("denominator must be positive")
>             value = Rational(numerator, denominator)
>         object.__setattr__(self, "_value", value)
  
>     @property
>     def value(self) -> Rational:
>         """The exact rational value of this frequency ratio."""
>         return self._value
  
>     @property
>     def numerator(self) -> int:
>         """Numerator of the ratio in lowest terms."""
>         return self._value.numerator
  
>     @property
>     def denominator(self) -> int:
>         """Denominator of the ratio in lowest terms."""
>         return self._value.denominator
  
>     def __mul__(self, other: FrequencyRatio) -> FrequencyRatio:
>         """Multiply two frequency ratios (add intervals)."""
>         if not isinstance(other, FrequencyRatio):
>             return NotImplemented
>         return FrequencyRatio(self._value * other._value)
  
>     def __truediv__(self, other: FrequencyRatio) -> FrequencyRatio:
>         """Divide two frequency ratios (subtract intervals)."""
>         if not isinstance(other, FrequencyRatio):
>             return NotImplemented
>         return FrequencyRatio(self._value / other._value)
  
>     def __pow__(self, exponent: int) -> FrequencyRatio:
>         """Raise frequency ratio to an integer power."""
>         return FrequencyRatio(self._value ** exponent)
  
>     def __eq__(self, other: object) -> bool:
>         if not isinstance(other, FrequencyRatio):
>             return NotImplemented
>         return self._value == other._value
  
>     def __hash__(self) -> int:
>         return hash(self._value)
  
>     def __str__(self) -> str:
>         return f"{self.numerator}:{self.denominator}"
  
>     def __repr__(self) -> str:
>         return f"FrequencyRatio({self.numerator}, {self.denominator})"
  
