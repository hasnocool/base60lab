>     if not s:
>         raise ValueError("empty string")
>     if s == "0":
>         return 0
  
>     digit_values = digit_value_for_base(base)
>     result = 0
  
>     if base == 60 and "," in s:
          # Comma-separated sexagesimal: each group is a place value
>         groups = s.split(",")
>         for group in groups:
>             if not group:
